datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  fullName     String
  phone        String?
  role         String        @default("CLIENT") // "CLIENT" | "STAFF" | "ADMIN"
  noShowCount  Int           @default(0)
  isBlocked    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  waitlists    Waitlist[]
}

model Table {
  id           String        @id @default(uuid())
  number       Int           @unique
  capacity     Int
  isActive     Boolean       @default(true)
  reservations Reservation[]
}

model Reservation {
  id           String   @id @default(uuid())
  userId       String
  tableId      String?
  date         DateTime
  startTime    String
  endTime      String
  guestCount   Int
  status       String   @default("CONFIRMED") // "PENDING_APPROVAL" | "CONFIRMED" | "SEATED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  table        Table?   @relation(fields: [tableId], references: [id])
}

model Waitlist {
  id            String    @id @default(uuid())
  userId        String
  date          DateTime
  shift         String
  guestCount    Int
  status        String    @default("WAITING") // "WAITING" | "NOTIFIED" | "EXPIRED" | "CONVERTED"
  notifiedUntil DateTime?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
}

model RestaurantConfig {
  id                     String  @id @default("default")
  allowTableDowngrade    Boolean @default(true)
  waitlistTimeoutMinutes Int     @default(15)
  closedDates            String  @default("[]")
}
